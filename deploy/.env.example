# Copy this file to .env before bringing up deploy/docker-compose.yml.
# .env is gitignored — never commit your real values.

# Your public domain (e.g. cogito.example.com). Filled into Caddy's public
# vhost. Must match BOTH:
#   1. The public hostname you route to this tunnel in the Cloudflare
#      dashboard (service address: https://cogito-caddy:443, "No TLS Verify"
#      enabled — Caddy uses an internal CA).
#   2. One of the origins in ALLOWED_ORIGINS in the root .env file:
#        ALLOWED_ORIGINS=https://cogito.home.arpa,https://cogito.example.com
# Placeholder is fine if you're only running the LAN vhost for now.
COGITO_PUBLIC_DOMAIN=cogito.example.com

# Tunnel token from the Cloudflare Zero Trust dashboard. Only needed if you
# run the cloudflared container (docker compose --profile tunnel up -d):
#   Networks -> Tunnels -> your tunnel -> Overview -> "Install connector"
#   Copy the token from the docker run command shown there.
TUNNEL_TOKEN=<paste-token-here>
